#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DOCKER_BIN="${DOCKER_BIN:-docker}"
GIT_BIN="${GIT_BIN:-git}"
PHP_IMAGE="${FIGHT_COMMON_PHP_IMAGE:-}"
WORKSPACE=''
OUTCOMES=''
LANES=()

usage() {
    echo 'Usage: ./bin/release certify <version>' >&2
    exit 2
}

sha256_file() {
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        sha256sum "$1" | awk '{print $1}'
    fi
}

validate_changelog_version() {
    local version="$1"
    local escaped_version="${version//./\\.}"

    if ! grep -Eq "^## \\[${escaped_version}\\] - [0-9]{4}-[0-9]{2}-[0-9]{2}$" "${ROOT_DIR}/CHANGELOG.md"; then
        echo "bin/release: CHANGELOG.md must contain a dated [${version}] release heading." >&2
        exit 3
    fi
}

cleanup() {
    local intended_status=$?

    trap - EXIT
    set +e
    local cleanup_status=0 target
    # Exported lanes are independent temporary repositories, never registered worktrees.
    # Their unique native projects must be absent before deleting their source binds.
    for target in ${LANES[@]+"${LANES[@]}"}; do
        if ! (cd "${target}" && ./bin/down --worktree "${target}"); then
            cleanup_status=1
            continue
        fi
        if ! python3 -B - "${target}" <<'PY'
import hashlib
from pathlib import Path
import sys
root = Path(sys.argv[1]).resolve()
sys.path.insert(0, str(root / 'scripts'))
from local_tooling import runtime
from local_tooling.resources import native_ids, require, run
project = runtime.selected(root, str(root))[2]
require(project == 'fight-common-release-' + hashlib.sha256(str(root).encode()).hexdigest()[:16],
        'Release lane identity changed; retain source')
runtime.guard(root, root, project)
for volume in native_ids(root, 'volumes', project):
    runtime.guard(root, root, project)
    run(['docker', 'volume', 'rm', volume], root)
for tag in sorted(runtime.image_tags(root, project)):
    runtime.guard(root, root, project)
    run(['docker', 'image', 'rm', tag], root)
require(not any(native_ids(root, kind, project) for kind in ('containers', 'networks', 'volumes'))
        and not runtime.image_tags(root, project), 'Release native retirement incomplete; retain source')
PY
        then
            cleanup_status=1
        fi
    done
    if (( cleanup_status == 0 )); then
        if [[ -n "${WORKSPACE}" && -d "${WORKSPACE}" ]]; then
            find "${WORKSPACE}" -depth -delete || cleanup_status=1
        fi
    else
        printf 'bin/release: native cleanup incomplete; source and evidence retained at %s\n' "${WORKSPACE}" >&2
    fi
    if (( intended_status == 0 && cleanup_status != 0 )); then
        intended_status=1
    fi
    exit "${intended_status}"
}

export_candidate() {
    local target="$1"

    mkdir -p "${target}"
    "${GIT_BIN}" -C "${ROOT_DIR}" archive "${COMMIT}" | tar -x -C "${target}"
    "${GIT_BIN}" -C "${target}" init --quiet
}

run_step() {
    local name="$1"
    local display="$2"
    local directory="$3"
    local output="$4"
    local started
    local finished
    local status

    shift 4
    started="$(date +%s)"
    printf '[release] %s\n' "${name}"
    set +e
    (
        cd "${directory}"
        "$@"
    ) > "${output}" 2>&1
    status=$?
    set -e
    finished="$(date +%s)"

    if (( status == 0 )); then
        printf '%s\tpassed\t0\t%s\t%s\t%s\n' \
            "${name}" "$(((finished - started) * 1000))" "$(sha256_file "${output}")" "${display}" \
            >> "${OUTCOMES}"
        return 0
    fi

    printf '%s\tfailed\t%s\t%s\t%s\t%s\n' \
        "${name}" "${status}" "$(((finished - started) * 1000))" "$(sha256_file "${output}")" "${display}" \
        >> "${OUTCOMES}"
    tail -80 "${output}" >&2
    printf 'bin/release: %s failed with exit code %s.\n' "${name}" "${status}" >&2
    return "${status}"
}

resolve_lowest_dependencies() {
    local target="$1"

    "${DOCKER_BIN}" container run --rm \
        -v "${target}:/app:delegated" \
        -w /app \
        --user "$(id -u):$(id -g)" \
        --env COMPOSER_HOME=/tmp/fight-common-release-composer \
        "${PHP_IMAGE}" \
        bash -c '
composer update --no-interaction --no-progress --prefer-dist
LOWEST_PACKAGES="$(php -r '\''
$composer = json_decode(file_get_contents("composer.json"), true, flags: JSON_THROW_ON_ERROR);
$requirements = $composer["require"];
$packages = array_filter(
    array_keys($requirements),
    static fn (string $package): bool => str_contains($package, "/"),
);
echo implode(" ", $packages);
'\'')"
composer update ${LOWEST_PACKAGES} --no-interaction --no-progress --prefer-dist --prefer-lowest --prefer-stable --with-all-dependencies
'
}

resolve_default_dependencies() {
    local target="$1"

    "${DOCKER_BIN}" container run --rm \
        -v "${target}:/app:delegated" \
        -w /app \
        --user "$(id -u):$(id -g)" \
        --env COMPOSER_HOME=/tmp/fight-common-release-composer \
        "${PHP_IMAGE}" \
        composer update --no-interaction --no-progress --prefer-dist
}

if (( $# != 2 )) || [[ "$1" != 'certify' ]]; then
    usage
fi

VERSION="$2"
if [[ ! "${VERSION}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    usage
fi

cd "${ROOT_DIR}"
if [[ -n "$("${GIT_BIN}" status --porcelain --untracked-files=all)" ]]; then
    echo 'bin/release: certification requires a clean checkout.' >&2
    exit 3
fi

validate_changelog_version "${VERSION}"

COMMIT="$("${GIT_BIN}" rev-parse --verify HEAD)"
if [[ ! "${COMMIT}" =~ ^[a-f0-9]{40}$ ]]; then
    echo 'bin/release: the exact candidate commit is unavailable.' >&2
    exit 3
fi
HANDOFF_DIR="${ROOT_DIR}/.runs/handoffs/release-${VERSION}-${COMMIT}"
if [[ -e "${HANDOFF_DIR}" ]]; then
    echo "bin/release: certification handoff already exists: ${HANDOFF_DIR}" >&2
    exit 3
fi

WORKSPACE="$(mktemp -d /tmp/fight-common-release-certify.XXXXXX)"
trap cleanup EXIT
OUTCOMES="${WORKSPACE}/command-outcomes.tsv"
touch "${OUTCOMES}"

DEFAULT_ROOT="${WORKSPACE}/default"
LATEST_ROOT="${WORKSPACE}/latest"
LOWEST_ROOT="${WORKSPACE}/lowest"
ARCHIVE_ROOT="${WORKSPACE}/archive-source"
ARTIFACT_ROOT="${WORKSPACE}/artifacts"
CONSUMER_ROOT="${WORKSPACE}/consumer"
mkdir -p "${ARTIFACT_ROOT}" "${CONSUMER_ROOT}"
export_candidate "${DEFAULT_ROOT}"
export_candidate "${LATEST_ROOT}"
export_candidate "${LOWEST_ROOT}"
# Only native runtime identity varies from the exact archived candidate. Each lane
# is its own canonical repository, so qualify a unique project before any Docker use.
for target in "${DEFAULT_ROOT}" "${LATEST_ROOT}" "${LOWEST_ROOT}"; do
    python3 - "${target}" <<'PY'
import hashlib
import json
from pathlib import Path
import sys
root = Path(sys.argv[1]).resolve()
path = root / 'etc/local-tooling.json'
config = json.loads(path.read_text())
config['project'] = 'fight-common-release-' + hashlib.sha256(str(root).encode()).hexdigest()[:16]
path.write_text(json.dumps(config, indent=2) + '\n')
print(str(root) + '\t' + config['project'])
PY
    LANES+=("${target}")
done > "${WORKSPACE}/lane-projects.tsv"
run_step 'prepare-certifier-image' './bin/up --worktree selected --build-only' \
    "${ROOT_DIR}" "${WORKSPACE}/prepare-image.log" ./bin/up --worktree "${ROOT_DIR}" --build-only
PHP_IMAGE="${PHP_IMAGE:-$(./bin/runtime image-name php)}"
run_step \
    'default-dependency-resolution' \
    'composer update' \
    "${DEFAULT_ROOT}" \
    "${WORKSPACE}/default.log" \
    resolve_default_dependencies "${DEFAULT_ROOT}"
run_step 'default-product-gate' 'FIGHT_COMMON_DEPENDENCY_PROFILE=resolved ./bin/build' "${DEFAULT_ROOT}" "${WORKSPACE}/default-product-gate.log" env FIGHT_COMMON_DEPENDENCY_PROFILE=resolved ./bin/build
run_step \
    'latest-dependency-resolution' \
    'composer update' \
    "${LATEST_ROOT}" \
    "${WORKSPACE}/latest.log" \
    "${DOCKER_BIN}" container run --rm \
        -v "${LATEST_ROOT}:/app:delegated" \
        -w /app \
        --user "$(id -u):$(id -g)" \
        --env COMPOSER_HOME=/tmp/fight-common-release-composer \
        "${PHP_IMAGE}" \
        composer update --no-interaction --no-progress --prefer-dist
run_step \
    'latest-product-gate' \
    'FIGHT_COMMON_DEPENDENCY_PROFILE=resolved ./bin/build' \
    "${LATEST_ROOT}" \
    "${WORKSPACE}/latest-product-gate.log" \
    env FIGHT_COMMON_DEPENDENCY_PROFILE=resolved ./bin/build
run_step \
    'lowest-dependency-resolution' \
    'composer update --prefer-lowest --prefer-stable' \
    "${LOWEST_ROOT}" \
    "${WORKSPACE}/lowest.log" \
    resolve_lowest_dependencies "${LOWEST_ROOT}"
run_step \
    'lowest-product-gate' \
    'FIGHT_COMMON_DEPENDENCY_PROFILE=resolved ./bin/build' \
    "${LOWEST_ROOT}" \
    "${WORKSPACE}/lowest-product-gate.log" \
    env FIGHT_COMMON_DEPENDENCY_PROFILE=resolved ./bin/build

# Keep installed dependencies and build output out of the consumer archive.
export_candidate "${ARCHIVE_ROOT}"
ARCHIVE="${ARTIFACT_ROOT}/fight-common-${VERSION}.tar"
"${DOCKER_BIN}" container run --rm \
    -v "${DEFAULT_ROOT}:/source:ro" \
    -v "${ARCHIVE_ROOT}:/archive:delegated" \
    -w /source \
    --user "$(id -u):$(id -g)" \
    "${PHP_IMAGE}" \
    php release/scripts/certify.php archive-manifest /archive/composer.json "${VERSION}"
run_step \
    'composer-archive' \
    'composer archive --format=tar' \
    "${ARCHIVE_ROOT}" \
    "${WORKSPACE}/archive.log" \
    "${DOCKER_BIN}" container run --rm \
        -v "${ARCHIVE_ROOT}:/app:ro" \
        -v "${ARTIFACT_ROOT}:/artifacts:delegated" \
        -w /app \
        --user "$(id -u):$(id -g)" \
        --env "COMPOSER_ROOT_VERSION=${VERSION}" \
        "${PHP_IMAGE}" \
        composer archive --no-interaction --format=tar --dir=/artifacts --file="fight-common-${VERSION}"

[[ -f "${ARCHIVE}" ]] || {
    echo 'bin/release: Composer did not create the expected archive.' >&2
    exit 4
}

"${DOCKER_BIN}" container run --rm \
    -v "${DEFAULT_ROOT}:/source:ro" \
    -v "${CONSUMER_ROOT}:/consumer:delegated" \
    -v "${ARTIFACT_ROOT}:/artifacts:ro" \
    -w /source \
    --user "$(id -u):$(id -g)" \
    "${PHP_IMAGE}" \
    php release/scripts/certify.php consumer-manifest /consumer/composer.json /artifacts "${VERSION}"

run_step \
    'consumer-resolution' \
    'composer update --no-dev --no-install' \
    "${CONSUMER_ROOT}" \
    "${WORKSPACE}/consumer-resolution.log" \
    "${DOCKER_BIN}" container run --rm \
        -v "${CONSUMER_ROOT}:/consumer:delegated" \
        -v "${ARTIFACT_ROOT}:/artifacts:ro" \
        -w /consumer \
        --user "$(id -u):$(id -g)" \
        --env COMPOSER_HOME=/tmp/fight-common-release-composer \
        "${PHP_IMAGE}" \
        composer update --no-dev --no-install --no-interaction --no-progress --prefer-dist --no-scripts
run_step \
    'production-install' \
    'composer install --no-dev' \
    "${CONSUMER_ROOT}" \
    "${WORKSPACE}/production-install.log" \
    "${DOCKER_BIN}" container run --rm \
        -v "${CONSUMER_ROOT}:/consumer:delegated" \
        -v "${ARTIFACT_ROOT}:/artifacts:ro" \
        -w /consumer \
        --user "$(id -u):$(id -g)" \
        --env COMPOSER_HOME=/tmp/fight-common-release-composer \
        "${PHP_IMAGE}" \
        composer install --no-dev --no-interaction --no-progress --prefer-dist --no-scripts
run_step \
    'installed-consumer-probe' \
    'php release/consumer/probe.php <installed-autoload.php>' \
    "${ROOT_DIR}" \
    "${WORKSPACE}/consumer.json" \
    "${DOCKER_BIN}" container run --rm \
        -v "${DEFAULT_ROOT}:/source:ro" \
        -v "${CONSUMER_ROOT}:/consumer:ro" \
        -w /source \
        "${PHP_IMAGE}" \
        php release/consumer/probe.php /consumer/vendor/autoload.php
run_step \
    'package-surface' \
    'compare installed archive with compatibility/manifest.json' \
    "${ROOT_DIR}" \
    "${WORKSPACE}/surface.json" \
    "${DOCKER_BIN}" container run --rm \
        -v "${DEFAULT_ROOT}:/source:ro" \
        -v "${CONSUMER_ROOT}:/consumer:ro" \
        -w /source \
        "${PHP_IMAGE}" \
        php release/scripts/certify.php surface \
            /consumer/vendor/johnnickell/fight-common \
            /consumer/vendor/johnnickell/fight-common/compatibility/manifest.json \
            "${COMMIT}"

STAGED_HANDOFF="${WORKSPACE}/handoff"
mkdir -p "${STAGED_HANDOFF}"
cp "${WORKSPACE}/lane-projects.tsv" "${STAGED_HANDOFF}/"
cp "${ARCHIVE}" "${STAGED_HANDOFF}/"
"${DOCKER_BIN}" container run --rm \
    -v "${DEFAULT_ROOT}:/source:ro" \
    -v "${WORKSPACE}:/evidence:ro" \
    -v "${STAGED_HANDOFF}:/handoff:delegated" \
    -w /source \
    --user "$(id -u):$(id -g)" \
    "${PHP_IMAGE}" \
    php release/scripts/certify.php record \
        "${VERSION}" \
        "${COMMIT}" \
        "/evidence/artifacts/$(basename "${ARCHIVE}")" \
        /evidence/command-outcomes.tsv \
        /source/composer.lock \
        /evidence/latest/composer.lock \
        /evidence/lowest/composer.lock \
        /evidence/surface.json \
        /evidence/consumer.json \
        /source/release/starter-receipts.json \
        /handoff/certification.json

mkdir -p "$(dirname "${HANDOFF_DIR}")"
mv "${STAGED_HANDOFF}" "${HANDOFF_DIR}"
printf 'Certified %s at %s\nEvidence: %s/certification.json\n' "${VERSION}" "${COMMIT}" "${HANDOFF_DIR}"
