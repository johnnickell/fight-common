#!/usr/bin/env bash

set -euo pipefail

printf '[quality] Composer validation\n'
composer validate --strict --no-interaction

printf '[quality] PHP syntax\n'
{
    find . -maxdepth 1 -type f -name '*.php' -print
    find src tests -type f -name '*.php' -print
} | LC_ALL=C sort | while IFS= read -r php_file; do
    php -l "${php_file#./}"
done

printf '[quality] Planning integrity\n'
./bin/planning-check

printf '[quality] PHPCS\n'
php vendor/bin/phpcs

printf '[quality] PHPStan\n'
php vendor/bin/phpstan analyse

printf '[quality] Architecture\n'
php vendor/bin/deptrac --fail-on-uncovered --report-uncovered --report-skipped
php vendor/bin/deptrac debug:unassigned --no-cache

printf '[quality] Rector dry-run\n'
php vendor/bin/rector process src/ --dry-run

printf '[quality] PHPUnit\n'
rm -f var/reports/coverage/clover.xml
php vendor/bin/phpunit --fail-on-skipped

printf '[quality] Exact coverage\n'
./bin/coverage
