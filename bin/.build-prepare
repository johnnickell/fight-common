#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
./bin/runtime up --worktree "$PWD"
case "${FIGHT_COMMON_DEPENDENCY_PROFILE:-default}" in
    default) ./bin/runtime docker compose exec -T php composer update --no-interaction --no-progress --prefer-dist ;;
    resolved) test -f composer.lock; test -f vendor/autoload.php ;;
    *) echo 'Unknown dependency profile' >&2; exit 2 ;;
esac
docker build --pull --provenance=false -t "$(./bin/runtime image-name docs)" ./etc/docker/python/
