#!/usr/bin/env bash

FIGHT_COMMON_MYSQL_IMAGE="mysql:8.4.11"
FIGHT_COMMON_POSTGRESQL_IMAGE="postgres:17"
# An explicit native locator reuses one qualified environment across roles.
FIGHT_COMMON_DATABASE_RUNTIME="${FIGHT_COMMON_DATABASE_RUNTIME:-}"
FIGHT_COMMON_DATABASE_RETENTION="${FIGHT_COMMON_DATABASE_RETENTION:-cleanup}"
case "${FIGHT_COMMON_DATABASE_RETENTION}" in
    cleanup|retain) ;;
    *) echo 'Database retention must be cleanup or retain.' >&2; exit 2 ;;
esac
FIGHT_COMMON_DATABASE_RUN_ID="${FIGHT_COMMON_DATABASE_RUNTIME%%:*}"
FIGHT_COMMON_DATABASE_RUN_ID="${FIGHT_COMMON_DATABASE_RUN_ID:-$(date +%s)-$$-${RANDOM}}"
FIGHT_COMMON_DATABASE_STARTED=no
FIGHT_COMMON_DATABASE_ALLOCATED=no
FIGHT_COMMON_DATABASE_NETWORK="fight-common-test-network-${FIGHT_COMMON_DATABASE_RUN_ID}"
FIGHT_COMMON_MYSQL_CONTAINER="fight-common-test-mysql-${FIGHT_COMMON_DATABASE_RUN_ID}"
FIGHT_COMMON_POSTGRESQL_CONTAINER="fight-common-test-postgresql-${FIGHT_COMMON_DATABASE_RUN_ID}"
FIGHT_COMMON_MYSQL_DSN="mysql://fight_common:fight_common@mysql:3306/fight_common"
FIGHT_COMMON_POSTGRESQL_DSN="postgresql://fight_common:fight_common@postgresql:5432/fight_common"

fight_common_disposable_databases_cleanup() {
    local status=$?

    if [[ "${FIGHT_COMMON_DATABASE_STARTED}" == yes ]]; then
        if [[ "${FIGHT_COMMON_DATABASE_RETENTION}" == retain ]]; then
            printf 'Retained maintenance database runtime: %s\n' "${FIGHT_COMMON_DATABASE_RUNTIME}"
        elif ! "${ROOT_DIR}/bin/database-runtime" down "${FIGHT_COMMON_DATABASE_RUNTIME}"; then
            echo 'Database cleanup failed; retain the printed locator and inspect native resources.' >&2
            if (( status == 0 )); then status=1; fi
        fi
    elif [[ "${FIGHT_COMMON_DATABASE_ALLOCATED}" == yes ]]; then
        echo "Partial database startup held on network ${FIGHT_COMMON_DATABASE_NETWORK}; inspect native resources." >&2
        if (( status == 0 )); then status=1; fi
    fi

    return "${status}"
}

fight_common_install_disposable_database_cleanup() {
    trap fight_common_disposable_databases_cleanup EXIT
}

fight_common_wait_for_database_health() {
    local container="$1"
    local deadline=$((SECONDS + 90))
    local health

    while (( SECONDS < deadline )); do
        health="$("${DOCKER_BIN}" inspect --format '{{.State.Health.Status}}' "${container}")"
        if [[ "${health}" == "healthy" ]]; then
            return 0
        fi
        if [[ "${health}" == "unhealthy" || "${health}" == "" ]]; then
            echo "Database container ${container} did not become healthy (status: ${health:-unknown})." >&2
            return 1
        fi
        sleep 2
    done

    echo "Timed out waiting for database container ${container} to become healthy." >&2
    return 1
}

fight_common_start_disposable_databases() {
    if [[ -n "${FIGHT_COMMON_DATABASE_RUNTIME}" ]]; then
        "${ROOT_DIR}/bin/database-runtime" check "${FIGHT_COMMON_DATABASE_RUNTIME}"
        FIGHT_COMMON_DATABASE_STARTED=yes
        return
    fi

    local network_id mysql_id postgresql_id mysql_volume postgresql_volume
    network_id="$("${DOCKER_BIN}" network create "${FIGHT_COMMON_DATABASE_NETWORK}")"
    FIGHT_COMMON_DATABASE_ALLOCATED=yes

    mysql_id="$("${DOCKER_BIN}" container run \
        --detach \
        --name "${FIGHT_COMMON_MYSQL_CONTAINER}" \
        --network "${FIGHT_COMMON_DATABASE_NETWORK}" \
        --network-alias mysql \
        --env MYSQL_DATABASE=fight_common \
        --env MYSQL_USER=fight_common \
        --env MYSQL_PASSWORD=fight_common \
        --env MYSQL_ROOT_PASSWORD=root \
        --health-cmd='mysqladmin ping --host=127.0.0.1 --user=root --password=root' \
        --health-interval=2s \
        --health-timeout=5s \
        --health-retries=30 \
        "${FIGHT_COMMON_MYSQL_IMAGE}")"

    postgresql_id="$("${DOCKER_BIN}" container run \
        --detach \
        --name "${FIGHT_COMMON_POSTGRESQL_CONTAINER}" \
        --network "${FIGHT_COMMON_DATABASE_NETWORK}" \
        --network-alias postgresql \
        --env POSTGRES_DB=fight_common \
        --env POSTGRES_USER=fight_common \
        --env POSTGRES_PASSWORD=fight_common \
        --health-cmd='pg_isready --username=fight_common --dbname=fight_common' \
        --health-interval=2s \
        --health-timeout=5s \
        --health-retries=30 \
        "${FIGHT_COMMON_POSTGRESQL_IMAGE}")"

    mysql_volume="$("${DOCKER_BIN}" inspect --format '{{(index .Mounts 0).Name}}' "${mysql_id}")"
    postgresql_volume="$("${DOCKER_BIN}" inspect --format '{{(index .Mounts 0).Name}}' "${postgresql_id}")"
    FIGHT_COMMON_DATABASE_RUNTIME="${FIGHT_COMMON_DATABASE_RUN_ID}:${network_id}:${mysql_id}:${postgresql_id}:${mysql_volume}:${postgresql_volume}"
    FIGHT_COMMON_DATABASE_STARTED=yes
    printf 'Maintenance database runtime: %s\n' "${FIGHT_COMMON_DATABASE_RUNTIME}"

    fight_common_wait_for_database_health "${FIGHT_COMMON_MYSQL_CONTAINER}"
    fight_common_wait_for_database_health "${FIGHT_COMMON_POSTGRESQL_CONTAINER}"
}
