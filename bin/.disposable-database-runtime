#!/usr/bin/env bash

FIGHT_COMMON_DATABASE_RUN_ID="$(date +%s)-$$-${RANDOM}"
FIGHT_COMMON_DATABASE_NETWORK="fight-common-test-network-${FIGHT_COMMON_DATABASE_RUN_ID}"
FIGHT_COMMON_MYSQL_CONTAINER="fight-common-test-mysql-${FIGHT_COMMON_DATABASE_RUN_ID}"
FIGHT_COMMON_POSTGRESQL_CONTAINER="fight-common-test-postgresql-${FIGHT_COMMON_DATABASE_RUN_ID}"
FIGHT_COMMON_MYSQL_DSN="mysql://fight_common:fight_common@mysql:3306/fight_common"
FIGHT_COMMON_POSTGRESQL_DSN="postgresql://fight_common:fight_common@postgresql:5432/fight_common"
FIGHT_COMMON_DATABASE_COMMON_DIR="$(git -C "${ROOT_DIR}" rev-parse --path-format=absolute --git-common-dir)"
FIGHT_COMMON_DATABASE_RECEIPT_DIR="${FIGHT_COMMON_DATABASE_RECEIPT_DIR:-$(dirname "${FIGHT_COMMON_DATABASE_COMMON_DIR}")/.runs/database-runs}"
FIGHT_COMMON_DATABASE_RECEIPT="${FIGHT_COMMON_DATABASE_RECEIPT_DIR}/${FIGHT_COMMON_DATABASE_RUN_ID}.json"

fight_common_disposable_databases_cleanup() {
    local status=$?
    trap - EXIT INT TERM
    if [[ -f "${FIGHT_COMMON_DATABASE_RECEIPT}" ]]; then
        if ! python3 "${ROOT_DIR}/bin/.disposable-database-lifecycle.py" cleanup \
            --docker "${DOCKER_BIN}" --receipt "${FIGHT_COMMON_DATABASE_RECEIPT}"; then
            echo "Database cleanup incomplete; retain and resume exact receipt: ${FIGHT_COMMON_DATABASE_RECEIPT}" >&2
            if (( status == 0 )); then status=1; fi
        fi
    fi
    return "${status}"
}

fight_common_install_disposable_database_cleanup() {
    trap fight_common_disposable_databases_cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
}

fight_common_start_disposable_databases() {
    python3 "${ROOT_DIR}/bin/.disposable-database-lifecycle.py" start \
        --docker "${DOCKER_BIN}" --receipt "${FIGHT_COMMON_DATABASE_RECEIPT}" \
        --run "${FIGHT_COMMON_DATABASE_RUN_ID}"
}
