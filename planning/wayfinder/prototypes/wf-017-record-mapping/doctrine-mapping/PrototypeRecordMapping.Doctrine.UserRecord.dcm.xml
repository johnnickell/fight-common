<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="PrototypeRecordMapping\Doctrine\UserRecord" table="mapping_users">
        <id name="id" type="string" column="id" length="80"/>
        <field name="email" type="string" column="email" length="255" unique="true"/>
        <many-to-many field="roles" target-entity="PrototypeRecordMapping\Doctrine\RoleRecord">
            <join-table name="mapping_user_roles">
                <join-columns>
                    <join-column name="user_id" referenced-column-name="id" on-delete="CASCADE"/>
                </join-columns>
                <inverse-join-columns>
                    <join-column name="role_id" referenced-column-name="id" on-delete="CASCADE"/>
                </inverse-join-columns>
            </join-table>
        </many-to-many>
    </entity>
</doctrine-mapping>
