{
    "prototype": "WF-017 refresh-cookie request security",
    "framework": "codeigniter",
    "packages": {
        "codeigniter4/framework": "v4.7.4"
    },
    "routes": [
        "POST /api/v1/access/session/refresh",
        "POST /api/v1/access/session/logout"
    ],
    "trusted_application_origin": "https://starter.example.test",
    "target_origin_source": "explicit project configuration, never Host or X-Forwarded-Host",
    "cookie_profile": "__Host- prefix; Path=/; Secure; HttpOnly; SameSite=Strict; no Domain",
    "cors_profile": "same-origin only; no credentialed cross-origin refresh/logout",
    "scenarios": {
        "same_origin": {
            "decision": "allowed",
            "reason": "same_origin_cookie_request"
        },
        "origin_fallback": {
            "decision": "allowed",
            "reason": "same_origin_cookie_request"
        },
        "same_site_subdomain": {
            "decision": "forbidden",
            "reason": "same_origin_fetch_required"
        },
        "cross_site": {
            "decision": "forbidden",
            "reason": "same_origin_fetch_required"
        },
        "missing_origin": {
            "decision": "forbidden",
            "reason": "exact_origin_required"
        },
        "null_origin": {
            "decision": "forbidden",
            "reason": "exact_origin_required"
        },
        "spoofed_forwarded_host": {
            "decision": "forbidden",
            "reason": "exact_origin_required"
        },
        "form_content_type": {
            "decision": "forbidden",
            "reason": "json_content_type_required"
        },
        "missing_cookie": {
            "decision": "unauthenticated",
            "reason": "refresh_cookie_required"
        },
        "get": {
            "decision": "method_not_allowed",
            "reason": "unsafe_endpoint_requires_post"
        }
    },
    "result": "passed"
}
