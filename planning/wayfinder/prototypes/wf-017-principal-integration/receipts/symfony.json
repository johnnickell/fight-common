{
    "prototype": "WF-017 principal integration",
    "framework": "symfony",
    "versions": {
        "symfony\/security-core": "v8.1.2"
    },
    "composition": {
        "native_boundary": "Symfony\\Component\\Security\\Core\\Authentication\\Token\\Storage\\TokenStorage",
        "adapter": "starter-owned token-storage principal provider"
    },
    "outcomes": {
        "valid": {
            "user_id": "user-1",
            "authentication_version": 7,
            "roles": [
                "ROLE_ADMIN"
            ],
            "permissions": [
                "LIST_USERS"
            ]
        },
        "anonymous": "denied",
        "missing-user": "denied",
        "disabled-user": "denied",
        "stale-authentication-version": "denied",
        "revoked-session": "denied",
        "wrong-session-owner": "denied"
    },
    "portable_contract": "Prototype\\PrincipalIntegration\\CurrentPrincipalProvider",
    "portable_value": "Prototype\\PrincipalIntegration\\AuthenticatedPrincipal",
    "pass": true
}
