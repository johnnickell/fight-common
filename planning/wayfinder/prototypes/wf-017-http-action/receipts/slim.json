{
    "prototype": "WF-017 native HTTP action",
    "framework": "Slim",
    "versions": {
        "nyholm\/psr7": "1.8.2"
    },
    "composition": {
        "route": "Slim App::get(\/api\/v1\/access\/users, route action)",
        "response": "Psr\\Http\\Message\\ResponseInterface",
        "jsend": "starter-owned PSR-7 response mapper"
    },
    "portable_handler": "Prototype\\HttpAction\\ListUsersQueryHandler",
    "portable_outcome": "Prototype\\HttpAction\\ListUsersOutcome",
    "responses": {
        "authorized": {
            "class": "Nyholm\\Psr7\\Response",
            "status": 200,
            "content_type": "application\/json",
            "body": {
                "status": "success",
                "data": {
                    "users": [
                        {
                            "id": "user-1",
                            "display_name": "Ada"
                        },
                        {
                            "id": "user-2",
                            "display_name": "Grace"
                        }
                    ]
                }
            }
        },
        "unauthenticated": {
            "class": "Nyholm\\Psr7\\Response",
            "status": 401,
            "content_type": "application\/json",
            "body": {
                "status": "fail",
                "data": {
                    "code": "authentication_required"
                }
            }
        },
        "forbidden": {
            "class": "Nyholm\\Psr7\\Response",
            "status": 403,
            "content_type": "application\/json",
            "body": {
                "status": "fail",
                "data": {
                    "code": "forbidden"
                }
            }
        }
    },
    "pass": true
}
