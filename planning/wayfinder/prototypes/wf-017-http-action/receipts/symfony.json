{
    "prototype": "WF-017 native HTTP action",
    "framework": "Symfony",
    "versions": {
        "symfony\/http-foundation": "v8.1.4"
    },
    "composition": {
        "route": "GET \/api\/v1\/access\/users -> invokable controller",
        "response": "Symfony\\Component\\HttpFoundation\\JsonResponse",
        "jsend": "starter-owned response mapper; Fight Common JSendResponse remains optional Symfony convenience"
    },
    "portable_handler": "Prototype\\HttpAction\\ListUsersQueryHandler",
    "portable_outcome": "Prototype\\HttpAction\\ListUsersOutcome",
    "responses": {
        "authorized": {
            "class": "Symfony\\Component\\HttpFoundation\\JsonResponse",
            "status": 200,
            "content_type": "application\/json",
            "body": {
                "status": "success",
                "data": {
                    "users": [
                        {
                            "id": "user-1",
                            "display_name": "Ada"
                        },
                        {
                            "id": "user-2",
                            "display_name": "Grace"
                        }
                    ]
                }
            }
        },
        "unauthenticated": {
            "class": "Symfony\\Component\\HttpFoundation\\JsonResponse",
            "status": 401,
            "content_type": "application\/json",
            "body": {
                "status": "fail",
                "data": {
                    "code": "authentication_required"
                }
            }
        },
        "forbidden": {
            "class": "Symfony\\Component\\HttpFoundation\\JsonResponse",
            "status": 403,
            "content_type": "application\/json",
            "body": {
                "status": "fail",
                "data": {
                    "code": "forbidden"
                }
            }
        }
    },
    "pass": true
}
