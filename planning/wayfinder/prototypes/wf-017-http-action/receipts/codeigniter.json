{
    "prototype": "WF-017 native HTTP action",
    "framework": "CodeIgniter",
    "versions": {
        "codeigniter4\/framework": "v4.7.4"
    },
    "composition": {
        "route": "Routes::get(api\/v1\/access\/users, invokable controller)",
        "response": "CodeIgniter\\HTTP\\Response",
        "jsend": "starter-owned response mapper using native response message API"
    },
    "portable_handler": "Prototype\\HttpAction\\ListUsersQueryHandler",
    "portable_outcome": "Prototype\\HttpAction\\ListUsersOutcome",
    "responses": {
        "authorized": {
            "class": "PrototypeCodeIgniterResponse",
            "status": 200,
            "content_type": "application\/json",
            "body": {
                "status": "success",
                "data": {
                    "users": [
                        {
                            "id": "user-1",
                            "display_name": "Ada"
                        },
                        {
                            "id": "user-2",
                            "display_name": "Grace"
                        }
                    ]
                }
            }
        },
        "unauthenticated": {
            "class": "PrototypeCodeIgniterResponse",
            "status": 401,
            "content_type": "application\/json",
            "body": {
                "status": "fail",
                "data": {
                    "code": "authentication_required"
                }
            }
        },
        "forbidden": {
            "class": "PrototypeCodeIgniterResponse",
            "status": 403,
            "content_type": "application\/json",
            "body": {
                "status": "fail",
                "data": {
                    "code": "forbidden"
                }
            }
        }
    },
    "pass": true
}
