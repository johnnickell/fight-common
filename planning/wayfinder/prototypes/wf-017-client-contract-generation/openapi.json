{
    "openapi": "3.1.0",
    "info": {
        "title": "WF-017 AccessControl HTTP contract prototype",
        "version": "0.0.0-prototype"
    },
    "paths": {
        "/api/v1/access/users": {
            "get": {
                "operationId": "listUsers",
                "responses": {
                    "200": {
                        "description": "Authorized paginated user list",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UserListSuccess"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationRequired"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    }
                }
            }
        }
    },
    "components": {
        "responses": {
            "AuthenticationRequired": {
                "description": "No current principal",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/JSendFailure"
                        }
                    }
                }
            },
            "Forbidden": {
                "description": "Current principal lacks LIST_USERS",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/JSendFailure"
                        }
                    }
                }
            }
        },
        "schemas": {
            "UserView": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "email", "state", "role_ids"],
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "state": {
                        "type": "string",
                        "enum": ["pending_activation", "active", "disabled", "deleted"]
                    },
                    "role_ids": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                }
            },
            "PaginationView": {
                "type": "object",
                "additionalProperties": false,
                "required": ["page", "per_page", "total"],
                "properties": {
                    "page": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "per_page": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "total": {
                        "type": "integer",
                        "minimum": 0
                    }
                }
            },
            "UserListData": {
                "type": "object",
                "additionalProperties": false,
                "required": ["users", "pagination"],
                "properties": {
                    "users": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/UserView"
                        }
                    },
                    "pagination": {
                        "$ref": "#/components/schemas/PaginationView"
                    }
                }
            },
            "UserListSuccess": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "data"],
                "properties": {
                    "status": {
                        "const": "success"
                    },
                    "data": {
                        "$ref": "#/components/schemas/UserListData"
                    }
                }
            },
            "JSendFailure": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "data"],
                "properties": {
                    "status": {
                        "const": "fail"
                    },
                    "data": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["reason"],
                        "properties": {
                            "reason": {
                                "type": "string",
                                "enum": ["authentication_required", "forbidden"]
                            }
                        }
                    }
                }
            }
        }
    }
}
