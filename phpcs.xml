<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="FightCommon">
    <description>Fight Common coding standard</description>

    <file>src</file>

    <rule ref="./src/Standards/Phpcs/FightCommon/ruleset.xml">

        <exclude name="FightCommon.Classes.NamedClassStructure" />
        <exclude name="FightCommon.Classes.NamedClassMemberSpacing" />
        <exclude name="FightCommon.Classes.NamedMethodSpacing" />
        <exclude name="FightCommon.Formatting.RequireVisibilityGroupSpacing" />

        <exclude name="FightCommon.Commenting.RequireMethodDocComment" />
        <exclude name="FightCommon.Commenting.RequireTypeDocComment" />
        <exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint" />
    </rule>
</ruleset>
